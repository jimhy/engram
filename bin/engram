#!/usr/bin/env bash
# engram launcher — picks the right platform binary and execs it.
# Hooks / commands call this (via bash) so one config works on win / linux / macOS.
set -e
dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# 平台判定优先用 bash 内建变量 $OSTYPE / $HOSTTYPE，而不是 fork `uname`：
# 每条 hook（SessionStart / UserPromptSubmit / Stop）都要过这个 shim，原来的
# `$(uname -s)` / `$(uname -m)` 每次都要起子进程，实测吃掉约 48ms/每条消息——
# 比引擎本体（p50 20ms）还贵一倍多，纯属白交的过路费。
# $OSTYPE / $HOSTTYPE 是 bash 在编译期写死的内建变量，读取零开销，
# 且在本项目支持的全部平台上与 uname 的取值一一对应。
# 认不出来时（变量为空、被人为清空、或 32 位 bash 跑在 64 位内核上这类怪组合）
# **不猜**，直接退回下面原封不动的 uname 逻辑——宁可慢 48ms，也不能把平台判错。
bin=""
case "${OSTYPE:-}" in
  # Git Bash / MSYS2 / Cygwin —— 对应 uname -s 的 MINGW* | MSYS* | CYGWIN* | Windows_NT
  msys*|cygwin*|win32*)
    bin="$dir/engram-windows-x86_64.exe" ;;
  # 对应 uname -s = Darwin（HOSTTYPE 认不出的怪架构留给下面兜底，与旧逻辑同样归到 x86_64）
  darwin*)
    case "${HOSTTYPE:-}" in
      arm64)  bin="$dir/engram-macos-aarch64" ;;
      x86_64) bin="$dir/engram-macos-x86_64" ;;
    esac ;;
  # 对应 uname -s = Linux（含 linux-gnu / linux-musl / linux-android）
  linux*)
    case "${HOSTTYPE:-}" in
      aarch64) bin="$dir/engram-linux-aarch64" ;;
      x86_64)  bin="$dir/engram-linux-x86_64" ;;
    esac ;;
esac

# 兜底：内建变量判不出来时走原来的 uname 分支，逐字保持旧行为（含 `*)` 归 Windows 的兜底）。
if [ -z "$bin" ]; then
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*|Windows_NT)
      bin="$dir/engram-windows-x86_64.exe" ;;
    Darwin)
      if [ "$(uname -m)" = "arm64" ]; then bin="$dir/engram-macos-aarch64"; else bin="$dir/engram-macos-x86_64"; fi ;;
    Linux)
      if [ "$(uname -m)" = "aarch64" ]; then bin="$dir/engram-linux-aarch64"; else bin="$dir/engram-linux-x86_64"; fi ;;
    *)
      bin="$dir/engram-windows-x86_64.exe" ;;
  esac
fi

# 二进制解析三档（ENGRAM_BIN 覆盖 → 公共位置 → 插件自带的兜底）。
# 公共位置 ~/.engram/bin/ 是**全机唯一一份**：与记忆库 ~/.engram 同目录、不隶属任何
# CLI，engram-kb sidecar 本来就装在那儿。各家 CLI 共用一份的好处是版本天然统一——
# 否则 claude 装 1.5.0、codex 还停在 1.3.0，同一个库被不同版本的引擎读写。
# 判断只做一次 `-f`（stat 级开销）：这条 shim 每条 hook 都要过，绝不能在这里起子进程。
if [ -n "${ENGRAM_BIN:-}" ]; then
  bin="$ENGRAM_BIN"
elif [ -f "$HOME/.engram/bin/$(basename "$bin")" ]; then
  bin="$HOME/.engram/bin/$(basename "$bin")"
fi

if [ ! -x "$bin" ] && [ ! -f "$bin" ]; then
  echo "engram: no binary for this platform at $bin (run a tagged release to build it)" >&2
  exit 127
fi
exec "$bin" "$@"
